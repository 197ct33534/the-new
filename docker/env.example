# Copy sang thư mục gốc thành .env:  cp docker/env.example .env
#
# Prod: docker compose up --build
# Dev Docker (hot reload): docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build web db
# Dev local (nhanh nhất): chỉ Postgres trong Docker, app chạy trên máy
#   npm run db:up
#   npm run dev          hoặc gộp: npm run dev:local
# Cần có DATABASE_URL bên dưới trỏ tới cổng host (mặc định 5432; đổi nếu dùng DB_PORT khác).
#
# Sau khi DB có bảng: npm run db:push && npm run db:seed
# (tài khoản mẫu: admin@example.com / admin123; reader@example.com / reader123)

# Bắt buộc khi chạy npm run dev trên máy — Prisma / Next.js đọc biến này
DATABASE_URL=postgresql://the_new:the_new_secret@127.0.0.1:5432/football_news?schema=public

# Bắt buộc — Auth.js
AUTH_SECRET=

# Trình duyệt truy cập app (khi map cổng 3000, giữ mặc định này)
AUTH_URL=http://localhost:3000
WEB_PORT=3000
# Tuỳ chọn — URL tuyệt đối cho RSS/OG (mặc định dùng AUTH_URL)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (dịch vụ `db` trong docker-compose; khớp với build DATABASE_URL ở compose)
POSTGRES_USER=the_new
POSTGRES_PASSWORD=the_new_secret
POSTGRES_DB=football_news
# Cổng PostgreSQL trên máy host (mặc định 5432). Chỉ dùng khi cần kết nối từ ngoài docker compose.
# DB_PORT=5432

# Tuỳ chọn — Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Tuỳ chọn — Upstash Redis (cache; có thể bỏ trống)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bí mật dùng cho service `cron` gọi /api/cron/publish-scheduled (đồng bộ với nội dung Authorization)
# Trên môi trường thật hãy đổi giá trị mạnh
CRON_SECRET=dev-cron-secret-change-in-production
